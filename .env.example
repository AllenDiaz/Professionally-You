# Copy to .env and fill in. Used by both the legacy notebook/app.py and the
# backend/ FastAPI service (via podman-compose's `env_file: .env`).

# --- Google Cloud / Vertex AI ---
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1
MODEL_NAME=google/gemini-2.5-pro
# Auth: run `gcloud auth application-default login`, or set
# GOOGLE_APPLICATION_CREDENTIALS to a service-account key path.

# --- Persona ---
PERSON_NAME=Allen Diaz

# --- Pushover (optional — notifications are skipped if unset) ---
PUSHOVER_USER=
PUSHOVER_TOKEN=

# --- Backend-only (defaults shown; uncomment to override) ---
# MAX_TOOL_ITERATIONS=6
# ENABLE_GUARDRAILS=true
# ENABLE_EVALUATOR=true
# CHAT_RATE_LIMIT=20/minute
# DATABASE_URL=sqlite:///./backend/data/app.db
# ADMIN_TOKEN=
# ALLOWED_ORIGINS=http://localhost:3000
